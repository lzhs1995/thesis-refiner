{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Pinned existing NotebookLM transport v1",
  "required": [
    "account_key",
    "notebook_id",
    "target_id",
    "workspace_uuid",
    "surface_uuid",
    "broker_module",
    "transport_artifacts",
    "commands",
    "existing_target_only",
    "no_navigation",
    "no_login",
    "no_default_write",
    "no_browser_launch"
  ],
  "properties": {
    "account_key": {
      "type": "string",
      "minLength": 1
    },
    "notebook_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "surface_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "existing_target_only": {
      "const": true
    },
    "no_navigation": {
      "const": true
    },
    "no_login": {
      "const": true
    },
    "no_default_write": {
      "const": true
    },
    "no_browser_launch": {
      "const": true
    },
    "broker_module": {
      "$ref": "#/$defs/fileRef"
    },
    "transport_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      },
      "minItems": 1
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "list",
          "source_add",
          "source_fulltext",
          "query"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "external_locks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resource_root": {
      "type": "string",
      "minLength": 1
    },
    "simulation": {
      "type": "boolean"
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(/|[A-Za-z]:[\\\\/])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
