{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Portable empirical trace v1",
  "required": [
    "schema_version",
    "task_id",
    "script",
    "inputs",
    "outputs",
    "runtime",
    "samples"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "script": {
      "$ref": "#/$defs/fileRef"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      },
      "minItems": 1
    },
    "runtime": {
      "type": "object",
      "required": [
        "session_id",
        "job_id",
        "transport",
        "source_revision",
        "installed_version",
        "loaded_version"
      ]
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "keys",
          "expected_n"
        ],
        "properties": {
          "artifact": {
            "$ref": "#/$defs/fileRef"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "expected_n": {
            "type": "integer",
            "minimum": 0
          },
          "same_members_as": {
            "$ref": "#/$defs/fileRef"
          }
        }
      }
    },
    "tables": {
      "type": "array"
    },
    "models": {
      "type": "array"
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "actual",
          "expected",
          "keys",
          "numeric_columns",
          "storage_precision",
          "display_rounding",
          "ci_method",
          "draws_requested",
          "draws_saved",
          "absolute_tolerance",
          "relative_tolerance"
        ],
        "properties": {
          "actual": {
            "$ref": "#/$defs/fileRef"
          },
          "expected": {
            "$ref": "#/$defs/fileRef"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "numeric_columns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    },
    "full_reproduction": {
      "type": "boolean"
    },
    "execution_receipt": {
      "$ref": "#/$defs/fileRef"
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(/|[A-Za-z]:[\\\\/])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
